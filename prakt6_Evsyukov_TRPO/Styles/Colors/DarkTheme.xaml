<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg" Color="Black"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="DimGray"/>
    <SolidColorBrush x:Key="TextMain" Color="WhiteSmoke"/>


    <SolidColorBrush x:Key="PrimaryBg" Color="RoyalBlue"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="CornflowerBlue"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="MidnightBlue"/>
    <SolidColorBrush x:Key="PrimaryFg" Color="White"/>


    <SolidColorBrush x:Key="DangerBg" Color="Firebrick"/>
    <SolidColorBrush x:Key="DangerHover" Color="Crimson"/>
    <SolidColorBrush x:Key="DangerPressed" Color="DarkRed"/>
    <SolidColorBrush x:Key="DangerFg" Color="White"/>


    <SolidColorBrush x:Key="DisabledBg" Color="DarkGray"/>
    <SolidColorBrush x:Key="DisabledFg" Color="Gray"/>
</ResourceDictionary>