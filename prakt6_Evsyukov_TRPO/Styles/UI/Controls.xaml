<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- НЕЯВНЫЙ СТИЛЬ (Implicit Style) для TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- НЕЯВНЫЙ СТИЛЬ для ProgressBar (индикатор нагрузки) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,5,0,15"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBg}"/>
        <Setter Property="Background" Value="{DynamicResource DisabledBg}"/>
    </Style>

    <!-- ========================================== -->
    <!-- БАЗОВЫЙ СТИЛЬ КНОПКИ (Уровень 1)           -->
    <!-- ========================================== -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}"/>
        <Setter Property="BorderThickness" Value="0"/>

        <!-- Собственный ControlTemplate (требование методички) -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <!-- Триггеры состояний (Hover, Pressed, Disabled) -->
                    <ControlTemplate.Triggers>
                        <!-- Наведение мыши (меняем цвет фона) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHover}"/>
                        </Trigger>
                        <!-- Нажатие (меняем цвет фона) -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryPressed}"/>
                        </Trigger>
                        <!-- Недоступное действие (Disabled) -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- УРОВЕНЬ 2: Именованный стиль "Опасная"     -->
    <!-- ========================================== -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
        <!-- Переопределяем триггеры для красной кнопки -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================== -->
    <!-- УРОВЕНЬ 3: Наследование от Опасной (Крупная) -->
    <!-- ========================================== -->
    <Style x:Key="LargeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="45"/>
    </Style>

    <!-- Еще один именованный стиль (Второстепенная кнопка) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledBg}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- НЕЯВНЫЙ СТИЛЬ для TextBox и ComboBox (требование 4-х неявных стилей) -->
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
</ResourceDictionary>